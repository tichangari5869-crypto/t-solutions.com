# Copy to .env, fill in, never commit .env. Run: node --env-file=.env server.js
NODE_ENV=production
PORT=3000
SITE_URL=https://your-domain.co.ke
ADMIN_EMAIL=you@example.com
# Make with: node hash-password.js "a long password"
ADMIN_PASS_HASH=
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set to 1 only when behind a reverse proxy (Caddy, nginx) that sets X-Forwarded-For
TRUST_PROXY=1
